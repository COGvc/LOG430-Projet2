@startuml hexa-services
title drone-management-service et service-ordering-service — ports et adaptateurs (vue d'ensemble)
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Client B2B\n(par la passerelle)" as Client
database "drone-db" as DDB
database "ordering-db" as ODB
component "slice-management-service\n(D2 interne, D3 avec jeton)" as Slice

package "drone-management-service" {
  package "Entrée (main.py)" as DIn #F0F0FF {
    component "API /api/drone-management/v1\n(JWT : client et D1)" as DPub
    component "API interne /internal/v1\n(D4 : sans jeton)" as DInt
  }
  package "Application (application.py)" as DApp #FFFFF0 {
    component "GestionDrones\nenregistrer · consulter · lister\nresoudre_identite (D4)" as DUc
    interface "DepotDrones" as DPRepo
  }
  package "Domaine (domain.py)" as DDom #F0FFF0 {
    component "Drone · IdentiteReseau\nImsi (masqué) · Iccid · SimType" as DEnt
  }
  package "Sortie (adapters_db.py)" as DOut #FFF0F0 {
    component "DepotDronesPostgres" as DARepo
  }
}

package "service-ordering-service" {
  package "Entrée (main.py)" as OIn #F0F0FF {
    component "API publique\n(JWT)" as OPub
    component "lifespan\n(assemblage, lance la relance)" as OBoot
  }
  package "Module catalogue (catalog.py)" as Cat #FFFFF0 {
    component "Catalogue\nlister · specification\n(chargé en mémoire au démarrage)" as CUc
    component "ServiceSpecification" as CEnt
  }
  package "Application (application.py)" as Ord #FFFFF0 {
    component "GestionCommandes\ncommander · consulter · lister" as OUc
    component "Relance\n(tâche de fond, réveillée\nà chaque commande)" as ORelay
    interface "DepotCommandes" as OPRepo
    interface "EligibiliteDrone (D1)" as PD1
    interface "DemandeActivation (D2)" as PD2
    interface "EtatServices (D3)" as PD3
  }
  package "Domaine (domain.py)" as ODom #F0FFF0 {
    component "Commande · ElementCommande\nempreinte · etat_global · recul" as OEnt
  }
  package "Sortie" as OOut #FFF0F0 {
    component "DepotCommandesPostgres\n(adapters_db.py)\ncharger (catalog_db.py)" as OARepo
    component "EligibiliteDroneHttp" as AD1
    component "DemandeActivationHttp\n(par un Disjoncteur)" as AD2
    component "EtatServicesHttp" as AD3
  }
}

Client --> DPub
Client --> OPub

DPub --> DUc
DInt --> DUc
DUc --> DEnt
DUc --> DPRepo
DARepo ..|> DPRepo
DARepo --> DDB

OPub --> OUc
OPub --> CUc
OBoot --> ORelay
ORelay --> OPRepo
ORelay --> PD2
OUc --> OEnt
OUc --> CUc : interface publique\ndu module seulement
CUc --> CEnt
OUc --> OPRepo
OUc --> PD1
OUc --> PD3
OARepo ..|> OPRepo
OARepo ..> CUc : alimente au démarrage
AD1 ..|> PD1
AD2 ..|> PD2
AD3 ..|> PD3
OARepo --> ODB

AD1 --> DPub : D1 (jeton transmis)
AD2 --> Slice : D2
AD3 --> Slice : D3 (jeton transmis)
Slice --> DInt : D4

note bottom of ODom
  Domaine : bibliothèque standard seulement.
  Application : aucun adaptateur ni framework.
  Vérifié par import-linter.
end note
@enduml
