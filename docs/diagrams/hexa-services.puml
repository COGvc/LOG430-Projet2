@startuml hexa-services
title drone-management-service et service-ordering-service — ports et adaptateurs (vue d'ensemble)
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Client B2B\n(par la passerelle)" as Client
database "drone-db" as DDB
database "ordering-db" as ODB
component "slice-management-service\n(D2 interne, D3 avec jeton)" as Slice

package "drone-management-service" {
  package "Entrée" as DIn #F0F0FF {
    component "API /api/drone-management/v1\n(JWT : client et D1)" as DPub
    component "API interne /internal/v1\n(D4 : sans jeton)" as DInt
  }
  package "Application" as DApp #FFFFF0 {
    component "RegisterDrone\nGetDrone · ListDrones" as DUcPub
    component "ResolveNetworkIdentity (D4)" as DUcInt
    interface "DroneRepository" as DPRepo
  }
  package "Domaine" as DDom #F0FFF0 {
    component "Drone · NetworkIdentity\nImsi (masqué) · Iccid · SimType" as DEnt
  }
  package "Sortie" as DOut #FFF0F0 {
    component "PostgresDroneRepository" as DARepo
  }
}

package "service-ordering-service" {
  package "Entrée" as OIn #F0F0FF {
    component "API publique\n(JWT)" as OPub
    component "Relance\n(boucle asyncio)" as ORelay
  }
  package "Module catalog" as Cat #FFFFF0 {
    component "ListCatalog\nGetServiceSpecification" as CUc
    component "ServiceSpecification" as CEnt
    interface "CatalogRepository" as CPRepo
  }
  package "Module ordering" as Ord #FFFFF0 {
    component "PlaceOrder · GetOrder · ListOrders\nDispatchPendingItems" as OUc
    component "Order · OrderItem\nderive_order_state()" as OEnt
    interface "OrderRepository" as OPRepo
    interface "DroneEligibilityPort (D1)" as PD1
    interface "ActivationRequestPort (D2)" as PD2
    interface "ServiceStatusPort (D3)" as PD3
    interface "OrderIdGenerator · Clock" as PMisc
  }
  package "Sortie" as OOut #FFF0F0 {
    component "PostgresOrderRepository\nPostgresCatalogRepository" as OARepo
    component "HttpDroneEligibility" as AD1
    component "CircuitBreaker → HttpActivationRequest" as AD2
    component "HttpServiceStatus" as AD3
  }
}

Client --> DPub
Client --> OPub

DPub --> DUcPub
DInt --> DUcInt
DUcPub --> DEnt
DUcInt --> DEnt
DUcPub --> DPRepo
DUcInt --> DPRepo
DARepo ..|> DPRepo
DARepo --> DDB

OPub --> OUc
OPub --> CUc
ORelay --> OUc
OUc --> OEnt
OUc --> CUc : interface publique\ndu module seulement
CUc --> CEnt
CUc --> CPRepo
OUc --> OPRepo
OUc --> PD1
OUc --> PD2
OUc --> PD3
OUc --> PMisc

OARepo ..|> OPRepo
OARepo ..|> CPRepo
AD1 ..|> PD1
AD2 ..|> PD2
AD3 ..|> PD3
OARepo --> ODB

AD1 --> DPub : D1 (jeton transmis)
AD2 --> Slice : D2
AD3 --> Slice : D3 (jeton transmis)
Slice --> DInt : D4
@enduml
