@startuml hexa-slice-service
title slice-management-service — architecture hexagonale (ports et adaptateurs)
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "service-ordering-service\n(D2, D3)" as Ordering
actor "Client B2B\n(par la passerelle)" as Client
database "slice-db" as DB
component "drone-management-service\n(D4)" as Drone
cloud "Cœur 5G\n(Phase 3 : Open5GS)" as Core

package "slice-management-service" {
  package "Entrée (main.py)" as IN #F0F0FF {
    component "API /api/slice-management/v1\nGET /service ?orderId | ?droneId\n(FastAPI + validation JWT)" as HttpPub
    component "API interne /internal/v1\nPOST /activation → 202\n(sans jeton : H3)" as HttpInt
    component "lifespan\n(assemblage, lance le traitement)" as Boot
  }
  package "Application (application.py)" as APP #FFFFF0 {
    component "GestionServices\ndemander_activation · services" as UcGest
    component "TraitementActivation\n(tâche de fond, jusqu'à 500 activations\nsimultanées, délai réseau 3 s)" as UcAct
    interface "InventaireServices" as PRepo
    interface "IdentiteReseauDrone (D4)" as PId
    interface "NetworkProvisioningPort\n(reseau.py)" as PNet
  }
  package "Domaine (domain.py)" as DOM #F0FFF0 {
    component "ServiceInstance\n(transitions d'état, échéance 30 s)" as Ent
    component "Etat · CauseEchec · ProvisioningOutcome\nImsi (masqué) · SliceConfiguration (S-NSSAI, DNN,\n5QI, ARP, AMBR) · recul" as VO
  }
  package "Sortie" as OUT #FFF0F0 {
    component "InventairePostgres\n(adapters_db.py : asyncpg,\nSKIP LOCKED, bail de 10 s)" as ARepo
    component "Disjoncteur" as CB
    component "IdentiteReseauHttp\n(main.py : httpx, délai 1 s)" as AId
    component "MockOpen5GSAdapter\n(reseau.py : latence, taux d'échec,\nécriture conditionnelle)" as AMock
    component "Open5GSAdapter\n(Phase 3)" as AReal #DDDDDD
  }
}

Client --> HttpPub
Ordering --> HttpInt : D2
Ordering --> HttpPub : D3 (jeton)

HttpPub --> UcGest
HttpInt --> UcGest
Boot --> UcAct
Boot ..> OUT : construit et injecte\n(NETWORK_ADAPTER=mock)

UcGest --> Ent
UcAct --> Ent
Ent --> VO

UcGest --> PRepo
UcGest ..> UcAct : réveil
UcAct --> PRepo
UcAct --> PId
UcAct --> PNet

ARepo ..|> PRepo
AId ..|> PId
AId --> CB : chaque appel passe\npar le disjoncteur
AMock ..|> PNet
AReal ..|> PNet

ARepo --> DB
CB --> Drone
AReal ..> Core

note bottom of DOM
  Domaine : bibliothèque standard seulement.
  Application : aucun adaptateur ni framework.
  Vérifié par import-linter.
end note
note bottom of ARepo
  Reprise après redémarrage : un service resté
  ACTIVATING redevient réclamable à la fin du bail.
end note
@enduml
